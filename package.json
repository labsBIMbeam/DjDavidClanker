{
  "name": "dj-david-clanker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DJ David Clanker - a two-deck DJ napplet (NIP-5D) for Wavlake value4value music",
  "scripts": {
    "dev": "vite --port 5173 --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --port 4173 --host 127.0.0.1",
    "shell": "vite build && node dev/serve-shell.mjs",
    "check": "node dev/automix-check.mjs && node dev/performer-check.mjs && node dev/key-check.mjs",
    "check:automix": "node dev/automix-check.mjs",
    "check:automix-e2e": "node dev/automix-e2e.mjs",
    "check:performer": "node dev/performer-check.mjs",
    "test-stab": "node dev/make-test-stab.mjs",
    "check:key": "node dev/key-check.mjs"
  },
  "dependencies": {
    "@napplet/sdk": "^0.27.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@napplet/shim": "^0.29.2",
    "@napplet/vite-plugin": "^0.14.1",
    "vite": "^8.2.0"
  }
}
