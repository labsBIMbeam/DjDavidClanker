{
  "name": "dj-david-clanker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "DJ David Clanker - a two-deck auto-DJ napplet (NIP-5D): Wavlake value4value, your own Navidrome crate, Audius/Jamendo/Archive discovery",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --port 5173 --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --port 4173 --host 127.0.0.1",
    "shell": "vite build && node dev/serve-shell.mjs",
    "build:totem": "vite build --config vite.totem.config.js",
    "build:synth": "vite build --config vite.synth.config.js",
    "test": "node --test dev/*.test.mjs",
    "test:browser": "node --test dev/manifest-check.test.mjs && node dev/music-browser-check.mjs"
  },
  "dependencies": {
    "@napplet/sdk": "^0.27.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@napplet/shim": "^0.29.2",
    "@napplet/vite-plugin": "^0.14.1",
    "playwright": "1.62.0",
    "vite": "^8.2.0"
  }
}
